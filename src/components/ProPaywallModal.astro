---
import { PRO_CSV_ENABLED } from '../config/monetisation';
import { withBase } from '../config/site';

interface Props {
  slug?: string;
}

const { slug = '' } = Astro.props;
const proHref = withBase('/pro/');
---

<dialog
  id="pro-paywall-modal"
  class="w-[min(92vw,28rem)] rounded-xl border border-ink-200 bg-white p-0 text-ink-900 shadow-soft backdrop:bg-ink-950/50"
  aria-labelledby="pro-title"
  data-pro-enabled={PRO_CSV_ENABLED ? 'true' : 'false'}
  data-slug={slug}
>
  <form method="dialog" class="flex items-start justify-between gap-3 border-b border-ink-100 px-5 py-4">
    <h2 id="pro-title" class="font-display text-xl font-semibold">
      {PRO_CSV_ENABLED ? 'Unlock Pro CSV' : 'Pro CSV coming soon'}
    </h2>
    <button
      value="cancel"
      class="rounded-md px-2 py-1 text-ink-500 hover:bg-ink-100 hover:text-ink-800"
      aria-label="Close Pro dialog"
    >
      Close
    </button>
  </form>
  <div class="space-y-3 px-5 py-4 text-sm text-ink-700">
    {
      PRO_CSV_ENABLED ? (
        <p>Checkout and CSV download are configured for this build.</p>
      ) : (
        <>
          <p>
            Bulk CSV export for GMarketShare rankings is not available yet.
            Licence review is still pending, so checkout and local unlock stay off.
          </p>
          <p>
            Follow updates on the{' '}
            <a class="font-semibold text-canopy-700 underline" href={proHref}>
              Pro page
            </a>
            .
          </p>
        </>
      )
    }
  </div>
</dialog>

<script is:inline>
  (function () {
    var modal = document.getElementById('pro-paywall-modal');
    var openers = document.querySelectorAll('[data-open-pro]');
    if (!modal || !openers.length) return;
    openers.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var trigger = btn.getAttribute('data-open-pro') || 'button';
        var slug = modal.getAttribute('data-slug') || '';
        if (window.msaTrack) {
          window.msaTrack('pro_modal_open', { trigger: trigger, slug: slug });
        }
        if (typeof modal.showModal === 'function') modal.showModal();
      });
    });
  })();
</script>
