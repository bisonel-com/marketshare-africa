---
import {
  ADSENSE_PUB_ID,
  ADSENSE_SLOT_ANCHOR,
  ADSENSE_SLOT_IN_TABLE,
  ADSENSE_SLOT_LEADERBOARD,
  adsEnabled,
} from '../config/monetisation';

interface Props {
  format: 'leaderboard' | 'in-table' | 'anchor';
  class?: string;
}

const { format, class: className = '' } = Astro.props;

const sizeClass =
  format === 'leaderboard'
    ? 'min-h-[90px]'
    : format === 'in-table'
      ? 'min-h-[250px]'
      : 'min-h-[50px]';

const slotId =
  format === 'leaderboard'
    ? ADSENSE_SLOT_LEADERBOARD
    : format === 'in-table'
      ? ADSENSE_SLOT_IN_TABLE
      : ADSENSE_SLOT_ANCHOR;

const enabled = adsEnabled();
const label =
  format === 'leaderboard'
    ? 'Advertisement'
    : format === 'in-table'
      ? 'Sponsored'
      : 'Ad';
---

<aside
  class:list={[
    'ad-slot w-full overflow-hidden rounded-md border border-dashed border-ink-200 bg-ink-100/40',
    sizeClass,
    className,
  ]}
  aria-label={label}
  data-ad-format={format}
  data-ad-enabled={enabled ? 'true' : 'false'}
>
  {
    enabled ? (
      <ins
        class="adsbygoogle block w-full"
        style={
          format === 'leaderboard'
            ? 'display:block;min-height:90px'
            : format === 'in-table'
              ? 'display:block;min-height:250px'
              : 'display:block;min-height:50px'
        }
        data-ad-client={ADSENSE_PUB_ID}
        data-ad-slot={slotId}
        data-ad-format={format === 'anchor' ? 'fluid' : 'auto'}
        data-full-width-responsive="true"
      />
    ) : (
      <div
        class:list={[
          'flex h-full w-full items-center justify-center text-xs tracking-wide text-ink-400',
          sizeClass,
        ]}
      >
        <span class="sr-only">{label} placeholder</span>
        <span aria-hidden="true">{label}</span>
      </div>
    )
  }
</aside>
