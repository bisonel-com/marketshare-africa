---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../config/site';
import type { MarketData } from '../utils/types';

interface Props {
  marketName: string;
  datasets: MarketData[];
  canonicalPath: string;
}

const { marketName, datasets, canonicalPath } = Astro.props;
---

<BaseLayout
  title={`${marketName} market share rankings | GMarketShare`}
  description={`Browse Statcounter-sourced brand market share rankings for ${marketName}.`}
  canonicalPath={canonicalPath}
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">{marketName}</h1>
    <p class="mt-3 text-ink-600">Choose a category to open the latest ranking.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        datasets.map((d) => {
          const leader = d.rankings[0];
          return (
            <li>
              <a
                href={withBase(`/${d.slug}/`)}
                class="block rounded-xl border border-ink-200 bg-white/80 p-5 shadow-soft hover:border-canopy-500/40"
              >
                <div class="font-display text-xl font-semibold text-ink-950">{d.category}</div>
                <div class="mt-2 text-sm text-ink-600">
                  Leader: {leader.brand} at {leader.sharePercent.toFixed(2)}% ({d.period})
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
