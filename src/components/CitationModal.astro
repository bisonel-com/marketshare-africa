---
import type { MarketData } from '../utils/types';
import {
  DERIVED_CREDIT_PLAIN,
  SOURCE_CREDIT_PLAIN,
} from '../config/licence';
import { SITE_NAME, canonicalUrl } from '../config/site';

interface Props {
  data: MarketData;
}

const { data } = Astro.props;
const pageUrl = canonicalUrl(`/${data.slug}/`);
const citation = [
  `${SITE_NAME}. (${data.period}). ${data.category} market share in ${data.market}. ${pageUrl}`,
  SOURCE_CREDIT_PLAIN,
  DERIVED_CREDIT_PLAIN,
  `Market-specific source page: ${data.sourceUrl}`,
].join(' ');
---

<dialog
  id="citation-modal"
  class="w-[min(92vw,32rem)] rounded-xl border border-ink-200 bg-white p-0 text-ink-900 shadow-soft backdrop:bg-ink-950/50"
  aria-labelledby="citation-title"
>
  <form method="dialog" class="flex items-start justify-between gap-3 border-b border-ink-100 px-5 py-4">
    <h2 id="citation-title" class="font-display text-xl font-semibold">Cite this data</h2>
    <button
      value="cancel"
      class="rounded-md px-2 py-1 text-ink-500 hover:bg-ink-100 hover:text-ink-800"
      aria-label="Close citation dialog"
    >
      Close
    </button>
  </form>
  <div class="space-y-3 px-5 py-4">
    <p class="text-sm text-ink-600">
      Copy a citation that credits Statcounter Global Stats and this page.
    </p>
    <textarea
      id="citation-text"
      class="h-36 w-full resize-y rounded-lg border border-ink-200 bg-ink-50 p-3 font-mono text-xs leading-relaxed text-ink-800"
      readonly
    >{citation}</textarea>
    <button
      type="button"
      id="citation-copy"
      class="inline-flex w-full items-center justify-center rounded-lg bg-canopy-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-canopy-700"
      data-slug={data.slug}
    >
      Copy citation
    </button>
    <p id="citation-status" class="min-h-[1.25rem] text-xs text-canopy-600" aria-live="polite"></p>
  </div>
</dialog>

<script is:inline>
  (function () {
    var modal = document.getElementById('citation-modal');
    var openBtn = document.getElementById('open-citation');
    var copyBtn = document.getElementById('citation-copy');
    var textEl = document.getElementById('citation-text');
    var statusEl = document.getElementById('citation-status');
    if (openBtn && modal) {
      openBtn.addEventListener('click', function () {
        if (typeof modal.showModal === 'function') modal.showModal();
      });
    }
    if (copyBtn && textEl) {
      copyBtn.addEventListener('click', function () {
        var slug = copyBtn.getAttribute('data-slug') || '';
        if (window.msaTrack) window.msaTrack('cite_data_click', { slug: slug });
        var value = textEl.value;
        function done(ok) {
          if (statusEl) statusEl.textContent = ok ? 'Copied to clipboard.' : 'Select the text and copy manually.';
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(value).then(function () { done(true); }).catch(function () { done(false); });
        } else {
          textEl.select();
          try { done(document.execCommand('copy')); } catch (e) { done(false); }
        }
      });
    }
  })();
</script>
