---
import {
  DERIVED_LICENSE_NAME,
  DERIVED_LICENSE_URL,
  SOURCE_HOME_URL,
  SOURCE_LICENSE_NAME,
  SOURCE_LICENSE_URL,
  SOURCE_NAME,
} from '../config/licence';

interface Props {
  sourceName?: string;
  sourceUrl?: string;
  sourceHomeUrl?: string;
  licenceName?: string;
  licenceUrl?: string;
  derivedLicenceName?: string;
  derivedLicenceUrl?: string;
  attributionNote?: string;
  /** When true, use Statcounter 3.0 / derived 4.0 default wording. */
  statcounterDefault?: boolean;
  class?: string;
}

const {
  sourceName = SOURCE_NAME,
  sourceUrl = SOURCE_HOME_URL,
  sourceHomeUrl = SOURCE_HOME_URL,
  licenceName = SOURCE_LICENSE_NAME,
  licenceUrl = SOURCE_LICENSE_URL,
  derivedLicenceName = DERIVED_LICENSE_NAME,
  derivedLicenceUrl = DERIVED_LICENSE_URL,
  attributionNote = '',
  statcounterDefault = false,
  class: className = '',
} = Astro.props;
---

<div class:list={['space-y-2 text-sm leading-relaxed text-ink-700', className]}>
  {
    statcounterDefault ? (
      <>
        <p>
          Data:{' '}
          <a class="font-semibold text-canopy-700 underline" href={sourceUrl} rel="noopener noreferrer">
            {SOURCE_NAME}
          </a>{' '}
          (<a class="underline" href={SOURCE_HOME_URL} rel="noopener noreferrer">{SOURCE_HOME_URL}</a>), licensed{' '}
          <a class="font-semibold text-canopy-700 underline" href={SOURCE_LICENSE_URL} rel="noopener noreferrer">
            {SOURCE_LICENSE_NAME}
          </a>{' '}
          (<a class="underline" href={SOURCE_LICENSE_URL} rel="noopener noreferrer">{SOURCE_LICENSE_URL}</a>).
        </p>
        <p>
          Derived rankings on this site are shared under{' '}
          <a class="font-semibold text-canopy-700 underline" href={DERIVED_LICENSE_URL} rel="noopener noreferrer">
            {DERIVED_LICENSE_NAME}
          </a>{' '}
          (<a class="underline" href={DERIVED_LICENSE_URL} rel="noopener noreferrer">{DERIVED_LICENSE_URL}</a>),
          relying on {SOURCE_LICENSE_NAME} section 4(b), which permits adaptations under a later version.
        </p>
      </>
    ) : (
      <>
        <p>
          Data:{' '}
          <a class="font-semibold text-canopy-700 underline" href={sourceUrl} rel="noopener noreferrer">
            {sourceName}
          </a>
          {sourceHomeUrl && (
            <>
              {' '}
              (<a class="underline" href={sourceHomeUrl} rel="noopener noreferrer">{sourceHomeUrl}</a>)
            </>
          )}
          , licensed{' '}
          <a class="font-semibold text-canopy-700 underline" href={licenceUrl} rel="noopener noreferrer">
            {licenceName}
          </a>
          {licenceUrl && (
            <>
              {' '}
              (<a class="underline" href={licenceUrl} rel="noopener noreferrer">{licenceUrl}</a>)
            </>
          )}
          .
        </p>
        {derivedLicenceName && (
          <p>
            Derived rankings are shared under{' '}
            <a class="font-semibold text-canopy-700 underline" href={derivedLicenceUrl} rel="noopener noreferrer">
              {derivedLicenceName}
            </a>
            {derivedLicenceUrl && (
              <>
                {' '}
                (<a class="underline" href={derivedLicenceUrl} rel="noopener noreferrer">{derivedLicenceUrl}</a>)
              </>
            )}
            .
          </p>
        )}
        {attributionNote && <p>{attributionNote}</p>}
      </>
    )
  }
</div>
