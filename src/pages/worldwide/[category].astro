---
import RankingPage from '../../components/RankingPage.astro';
import { getAllMarketData, getMarketDataBySlug } from '../../utils/data';

export function getStaticPaths() {
  return getAllMarketData()
    .filter((d) => d.scope === 'worldwide')
    .map((d) => ({ params: { category: d.categorySlug } }));
}

const { category } = Astro.params;
const data = getMarketDataBySlug(`worldwide/${category}`);
if (!data) throw new Error(`Missing data for worldwide/${category}`);
---

<RankingPage data={data} hubHref="/worldwide/" hubLabel="More Worldwide rankings" />
