---
import RankingPage from '../../../components/RankingPage.astro';
import { getAllMarketData, getMarketDataBySlug } from '../../../utils/data';

export function getStaticPaths() {
  return getAllMarketData()
    .filter((d) => d.scope === 'region')
    .map((d) => ({
      params: { region: d.marketSlug, category: d.categorySlug },
    }));
}

const { region, category } = Astro.params;
const data = getMarketDataBySlug(`region/${region}/${category}`);
if (!data) throw new Error(`Missing data for region/${region}/${category}`);
---

<RankingPage
  data={data}
  hubHref={`/region/${region}/`}
  hubLabel={`More ${data.market} rankings`}
/>
