---
import BaseLayout from '../layouts/BaseLayout.astro';
import LicenceCredit from '../components/LicenceCredit.astro';
import {
  DERIVED_LICENSE_NAME,
  DERIVED_LICENSE_URL,
  SOURCE_LICENSE_NAME,
  SOURCE_LICENSE_URL,
  SOURCE_NAME,
} from '../config/licence';
import { SITE_NAME, withBase } from '../config/site';
---

<BaseLayout
  title={`Licence | ${SITE_NAME}`}
  description={`Licence and attribution for ${SITE_NAME}: Statcounter source data under CC BY-SA 3.0; derived rankings under CC BY-SA 4.0.`}
  canonicalPath="/licence/"
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">Licence</h1>
    <p class="mt-4 text-base leading-relaxed text-ink-700">
      {SITE_NAME} republishes market-share figures from {SOURCE_NAME} and publishes derived
      rankings adapted from those figures. The two layers use different Creative Commons versions
      as allowed by the source licence.
    </p>

    <h2 class="mt-10 font-display text-2xl font-semibold text-ink-950">Attribution</h2>
    <LicenceCredit class="mt-4" />

    <h2 class="mt-10 font-display text-2xl font-semibold text-ink-950">Source data</h2>
    <p class="mt-4 text-ink-700">
      Underlying Statcounter Global Stats downloads remain licensed{' '}
      <a class="font-semibold text-canopy-700 underline" href={SOURCE_LICENSE_URL} rel="noopener noreferrer">
        {SOURCE_LICENSE_NAME}
      </a>
      . Always credit Statcounter when reusing the source figures.
    </p>

    <h2 class="mt-10 font-display text-2xl font-semibold text-ink-950">Derived rankings</h2>
    <p class="mt-4 text-ink-700">
      Rankings, summaries, and adapted tables on this site are shared under{' '}
      <a class="font-semibold text-canopy-700 underline" href={DERIVED_LICENSE_URL} rel="noopener noreferrer">
        {DERIVED_LICENSE_NAME}
      </a>
      . This relies on {SOURCE_LICENSE_NAME}{' '}
      <a
        class="font-semibold text-canopy-700 underline"
        href={SOURCE_LICENSE_URL}
        rel="noopener noreferrer"
      >
        section 4(b)
      </a>
      , which permits adaptations under a later version of the same licence family.
    </p>

    <p class="mt-8 text-sm text-ink-600">
      © {SITE_NAME}. Not affiliated with Statcounter. Pro CSV export remains disabled.
    </p>

    <p class="mt-8">
      <a class="font-semibold text-canopy-700 underline" href={withBase('/about/')}>Methodology</a>
      {' · '}
      <a class="font-semibold text-canopy-700 underline" href={withBase('/')}>Back to rankings</a>
    </p>
  </article>
</BaseLayout>
