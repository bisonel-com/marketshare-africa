---
import RankingPage from '../../components/RankingPage.astro';
import { getAllMarketData, getMarketDataBySlug } from '../../utils/data';

export function getStaticPaths() {
  return getAllMarketData()
    .filter((d) => d.scope === 'country')
    .map((d) => ({
      params: { country: d.marketSlug, category: d.categorySlug },
    }));
}

const { country, category } = Astro.params;
const data = getMarketDataBySlug(`${country}/${category}`);
if (!data) throw new Error(`Missing data for ${country}/${category}`);
---

<RankingPage
  data={data}
  hubHref={`/${country}/`}
  hubLabel={`More ${data.market} rankings`}
/>
