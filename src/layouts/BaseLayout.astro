---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { adsEnabled, ADSENSE_PUB_ID } from '../config/monetisation';
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
  canonicalUrl,
  withBase,
} from '../config/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalPath = '/',
  ogType = 'website',
  jsonLd,
  noIndex = false,
} = Astro.props;

const canonical = canonicalPath.startsWith('http')
  ? canonicalPath
  : canonicalUrl(canonicalPath);
const homeHref = withBase('/');
const aboutHref = withBase('/about/');
const proHref = withBase('/pro/');
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    {
      adsEnabled() && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUB_ID}`}
          crossorigin="anonymous"
        />
      )
    }
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    <header class="border-b border-ink-200/70 bg-white/70 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href={homeHref} class="group flex flex-col">
          <span class="font-display text-xl font-bold tracking-tight text-ink-950 sm:text-2xl">
            {SITE_NAME}
          </span>
          <span class="text-[0.7rem] font-medium uppercase tracking-[0.14em] text-ink-500">
            {SITE_TAGLINE}
          </span>
        </a>
        <nav class="flex items-center gap-3 text-sm font-medium text-ink-700" aria-label="Primary">
          <a class="hover:text-canopy-700" href={aboutHref}>About</a>
          <a class="hover:text-canopy-700" href={proHref}>Pro</a>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-auto border-t border-ink-200 bg-ink-900 text-ink-200">
      <div class="mx-auto max-w-5xl space-y-4 px-4 py-10 sm:px-6">
        <p class="font-display text-lg font-semibold text-white">{SITE_NAME}</p>
        <p class="max-w-2xl text-sm leading-relaxed text-ink-300">
          Market share rankings worldwide and by country, republished from{' '}
          <a
            class="underline decoration-ink-500 underline-offset-2 hover:text-white"
            href="https://gs.statcounter.com/"
            rel="noopener noreferrer"
          >
            Statcounter Global Stats
          </a>
          . Data is licensed{' '}
          <a
            class="underline decoration-ink-500 underline-offset-2 hover:text-white"
            href="https://creativecommons.org/licenses/by-sa/3.0/"
            rel="noopener noreferrer"
          >
            CC BY-SA 3.0
          </a>
          . Always credit the source on reuse.
        </p>
        <p class="text-xs text-ink-400">
          Built by Bisonel Ltd. Not affiliated with Statcounter.
        </p>
        <div class="flex flex-wrap gap-4 text-sm">
          <a class="hover:text-white" href={aboutHref}>Methodology</a>
          <a class="hover:text-white" href={proHref}>Pro</a>
          <a class="hover:text-white" href={homeHref}>Home</a>
        </div>
      </div>
    </footer>
  </body>
</html>
